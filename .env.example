# CloudSage AI Environment Configuration
# Note: ZERO API keys or paid accounts are required to run CloudSage AI!
# CloudSage AI operates 100% in local Demo Mode with full realistic AWS billing
# telemetry and rule-based cost optimization recommendations out of the box.

# Session Secret for Express Session Store & Multi-Tenancy
SESSION_SECRET="cloudsage-finops-development-session-key-2026"

# Google OAuth 2.0 Credentials (Issue 2)
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# (Optional) GEMINI_API_KEY: Only needed if testing live external AI models.
# If omitted, CloudSage AI seamlessly uses its built-in rule-based FinOps engine.
GEMINI_API_KEY=""

# (Optional) AWS Configuration: Only needed if connecting a live production AWS account.
# In Demo Mode, realistic sample data is used automatically with zero credentials needed.
AWS_REGION="us-east-1"
